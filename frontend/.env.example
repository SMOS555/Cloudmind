# CloudMind Frontend Environment Variables

# Backend API Base URL (leave empty or set to your deployed backend URL without trailing slash)
# Example: https://cloudmind-backend.onrender.com
VITE_BACKEND_URL=http://127.0.0.1:8000

# Supabase Auth Configuration (Required for user authentication & accounts)
# Find these in your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
