# CloudMind Backend Environment Variables

# AI Service (Required for AI Cloud Agent chat)
# Get a free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Server Port (automatically set by Render, Railway, etc.)
PORT=8000

# CORS Configuration (defaults to allowing all frontend origins)
ALLOW_ALL_CORS=true
# CORS_ORIGINS=https://your-frontend-app.onrender.com,https://your-domain.com

# Fallback AWS Credentials (optional - users can configure keys dynamically on Dashboard)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
